rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only these specific accounts may administer content.
    // Firebase sign-up is/was publicly reachable, so "request.auth != null"
    // is NOT a sufficient admin check — it must be an explicit allowlist.
    function isAdmin() {
      return request.auth != null && (
        request.auth.uid in [
          "9dFkbPZscRZXAiEkpEVlGNJ1gKm2", // admin@fibernorth.com
          "GNYhCjyGudc2qnDoVzRnxCH4kuw2", // bill@fibernorth.com (original UID)
          "2CIJrJ2DgxXIBULzPEb76mArbWX2"  // webadmin@fibernorth.com
        ]
        // Email fallback so re-created admin accounts keep working.
        // Safe only while public sign-up is disabled in Firebase Auth.
        || request.auth.token.email in [
          "admin@fibernorth.com",
          "bill@fibernorth.com",
          "webadmin@fibernorth.com"
        ]
      );
    }

    // Public read for all site content
    match /siteContent/{doc} { allow read: if true; allow write: if isAdmin(); }
    match /services/{doc} { allow read: if true; allow write: if isAdmin(); }
    match /projects/{doc} { allow read: if true; allow write: if isAdmin(); }
    match /majorProjects/{doc} { allow read: if true; allow write: if isAdmin(); }
    match /fleet/{doc} { allow read: if true; allow write: if isAdmin(); }
    match /team/{doc} { allow read: if true; allow write: if isAdmin(); }
    match /blog/{doc} { allow read: if true; allow write: if isAdmin(); }
    match /testimonials/{doc} { allow read: if true; allow write: if isAdmin(); }
    match /jobPostings/{doc} { allow read: if true; allow write: if isAdmin(); }
    match /siteSettings/{doc} { allow read: if true; allow write: if isAdmin(); }

    // Anyone can submit quotes and applications; only admins can see or manage them.
    // Public creates are shape-constrained so spam can't write arbitrary documents.
    match /quoteRequests/{doc} {
      allow create: if request.resource.data.keys().hasOnly([
          'name', 'phone', 'email', 'address', 'serviceType', 'description',
          'urgency', 'mapAnnotation', 'mapImageUrl', 'propertyPhotos',
          'howHeard', 'status', 'notes', 'createdAt'
        ])
        && request.resource.data.name is string && request.resource.data.name.size() <= 200
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 40
        && request.resource.data.email is string && request.resource.data.email.size() <= 200
        && request.resource.data.address is string && request.resource.data.address.size() <= 400
        && request.resource.data.description is string && request.resource.data.description.size() <= 5000;
      allow read, update, delete: if isAdmin();
    }
    match /jobApplications/{doc} {
      allow create: if request.resource.data.keys().hasOnly([
          'name', 'phone', 'email', 'positionsInterested', 'hasCDL',
          'equipmentExperience', 'resumeUrl', 'howHeard', 'status', 'notes', 'createdAt'
        ])
        && request.resource.data.name is string && request.resource.data.name.size() <= 200
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 40
        && request.resource.data.email is string && request.resource.data.email.size() <= 200
        && request.resource.data.equipmentExperience is string && request.resource.data.equipmentExperience.size() <= 5000;
      allow read, update, delete: if isAdmin();
    }

    // Users collection: admin only
    match /users/{userId} { allow read, write: if isAdmin(); }

    // Campaign link counters: written only by the Admin SDK (/camp route),
    // read by the admin dashboard.
    match /linkStats/{doc} { allow read: if isAdmin(); allow write: if false; }
  }
}
