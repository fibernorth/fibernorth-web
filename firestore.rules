rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only these specific accounts may administer content.
    // Firebase sign-up is/was publicly reachable, so "request.auth != null"
    // is NOT a sufficient admin check — it must be an explicit allowlist.
    function isAdmin() {
      return request.auth != null && (
        request.auth.uid in [
          "9dFkbPZscRZXAiEkpEVlGNJ1gKm2", // admin@fibernorth.com
          "GNYhCjyGudc2qnDoVzRnxCH4kuw2", // bill@fibernorth.com (original UID)
          "2CIJrJ2DgxXIBULzPEb76mArbWX2"  // webadmin@fibernorth.com
        ]
        // Email fallback so re-created admin accounts keep working.
        // Only for VERIFIED emails; keep public sign-up disabled too.
        || (request.auth.token.email_verified == true
            && request.auth.token.email in [
              "admin@fibernorth.com",
              "bill@fibernorth.com",
              "webadmin@fibernorth.com"
            ])
        // Users added under Admin -> Users get this custom claim.
        || request.auth.token.admin == true
      );
    }

    // Admin user profiles (name/email for the Users page); claim is the
    // source of truth, this is display data.
    match /adminUsers/{uid} { allow read, write: if isAdmin(); }

    // Public read for all site content
    match /siteContent/{doc} { allow read: if true; allow write: if isAdmin(); }
    match /services/{doc} { allow read: if true; allow write: if isAdmin(); }
    match /projects/{doc} { allow read: if true; allow write: if isAdmin(); }
    match /majorProjects/{doc} { allow read: if true; allow write: if isAdmin(); }
    match /fleet/{doc} { allow read: if true; allow write: if isAdmin(); }
    match /team/{doc} { allow read: if true; allow write: if isAdmin(); }
    match /blog/{doc} { allow read: if true; allow write: if isAdmin(); }
    match /testimonials/{doc} { allow read: if true; allow write: if isAdmin(); }
    match /jobPostings/{doc} { allow read: if true; allow write: if isAdmin(); }
    match /siteSettings/{doc} { allow read: if true; allow write: if isAdmin(); }

    // Public quote/application submissions go through /api/quote and
    // /api/application (Admin SDK: zod validation + rate limit), so no client
    // may create these directly. Admins read/manage them in the CMS.
    match /quoteRequests/{doc} {
      allow create: if false;
      allow read, update, delete: if isAdmin();
    }
    match /jobApplications/{doc} {
      allow create: if false;
      allow read, update, delete: if isAdmin();
    }

    // Users collection: admin only
    match /users/{userId} { allow read, write: if isAdmin(); }

    // Campaign link counters: written only by the Admin SDK (/camp route),
    // read by the admin dashboard. The visits subcollection logs per-visit
    // IP/UA so the owner can spot his own test hits.
    match /linkStats/{doc} {
      allow read: if isAdmin();
      allow write: if false;
      match /visits/{visit} { allow read: if isAdmin(); allow write: if false; }
    }

    // Bid board: tracked bid opportunities, admin only.
    match /bids/{doc} { allow read, write: if isAdmin(); }

    // Lead pipeline (CRM). Admins read it live in the browser; every write
    // goes through the server (lead card and Add lead server actions, the
    // voice assistant, Meta ads sheet sync, quote form, proposals), which
    // enforces the stage rules and appends history without losing entries.
    match /leads/{doc} { allow read: if isAdmin(); allow write: if false; }

    // Monthly marketing spend by lead source (dashboard cost per won job).
    // Doc id = YYYY-MM. Read and written through server actions; direct
    // admin reads allowed, no browser writes.
    match /marketingSpend/{month} { allow read: if isAdmin(); allow write: if false; }

    // Sent proposals (immutable snapshots, doc id = public token). Written only
    // by the server; customers read them through /proposal/<token>.
    match /proposals/{token} { allow read: if isAdmin(); allow write: if false; }

    // Integration credentials (Bore-ON API key, etc). NEVER world-readable —
    // that's why these are not in siteSettings. Not readable from any
    // browser either (admins included): Admin -> Settings gets set/last-4
    // status from the getIntegrationStatus server action and saves through
    // updateIntegrationSecret, both Admin SDK.
    match /integrationSecrets/{doc} { allow read, write: if false; }

    // Last sync result per integration (e.g. googleCalendar: lastOkAt,
    // lastError, lastErrorAt). Written by the server; Settings reads it
    // through the getIntegrationStatus server action.
    match /integrationStatus/{d} { allow read, write: if false; }
  }
}
