rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only these specific accounts may administer content.
    // Firebase sign-up is/was publicly reachable, so "request.auth != null"
    // is NOT a sufficient admin check — it must be an explicit allowlist.
    function isAdmin() {
      return request.auth != null && (
        request.auth.uid in [
          "9dFkbPZscRZXAiEkpEVlGNJ1gKm2", // admin@fibernorth.com
          "GNYhCjyGudc2qnDoVzRnxCH4kuw2", // bill@fibernorth.com (original UID)
          "2CIJrJ2DgxXIBULzPEb76mArbWX2"  // webadmin@fibernorth.com
        ]
        // Email fallback so re-created admin accounts keep working.
        // Only for VERIFIED emails; keep public sign-up disabled too.
        || (request.auth.token.email_verified == true
            && request.auth.token.email in [
              "admin@fibernorth.com",
              "bill@fibernorth.com",
              "webadmin@fibernorth.com"
            ])
        // Users added under Admin -> Users get this custom claim.
        || request.auth.token.admin == true
      );
    }

    // The built-in owner accounts (keep in sync with isOwnerIdentity in
    // src/lib/admin-allowlist.ts). Staff added under Admin -> Users have the
    // admin claim but are not owners.
    function isOwner() {
      return request.auth != null && (
        request.auth.uid in [
          "9dFkbPZscRZXAiEkpEVlGNJ1gKm2",
          "GNYhCjyGudc2qnDoVzRnxCH4kuw2",
          "2CIJrJ2DgxXIBULzPEb76mArbWX2"
        ]
        || (request.auth.token.email_verified == true
            && request.auth.token.email in [
              "admin@fibernorth.com",
              "bill@fibernorth.com",
              "webadmin@fibernorth.com"
            ])
      );
    }

    // Every admin write below goes through server actions (Admin SDK), which
    // validate the fields, check roles (deletes are owner only), move deletes
    // to the trash and write the change log. So browsers may read, but not
    // write, these collections: a stolen admin token can't bulk-delete or
    // rewrite them over REST.

    // Admin user profiles (name/email for the Users page); claim is the
    // source of truth, this is display data. Written by src/actions/users.ts.
    match /adminUsers/{uid} { allow read: if isAdmin(); allow write: if false; }

    // Public read for all site content (writes: src/actions/crud.ts,
    // content.ts).
    match /siteContent/{doc} { allow read: if true; allow write: if false; }
    match /services/{doc} { allow read: if true; allow write: if false; }
    match /projects/{doc} { allow read: if true; allow write: if false; }
    match /majorProjects/{doc} { allow read: if true; allow write: if false; }
    match /fleet/{doc} { allow read: if true; allow write: if false; }
    match /team/{doc} { allow read: if true; allow write: if false; }
    match /blog/{doc} { allow read: if true; allow write: if false; }
    match /testimonials/{doc} { allow read: if true; allow write: if false; }
    match /jobPostings/{doc} { allow read: if true; allow write: if false; }
    match /siteSettings/{doc} { allow read: if true; allow write: if false; }

    // Public quote/application submissions go through /api/quote and
    // /api/application (Admin SDK: zod validation + rate limit), so no client
    // may create these directly. Admins read/manage them in the CMS.
    match /quoteRequests/{doc} {
      // Quotes change only through server actions (src/actions/quotes.ts),
      // which keep the lead and proposals in step.
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }
    match /jobApplications/{doc} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // Users collection: admin read only (nothing in the app writes it).
    match /users/{userId} { allow read: if isAdmin(); allow write: if false; }

    // Campaign link counters: written only by the Admin SDK (/camp route),
    // read by the admin dashboard. The visits subcollection logs per-visit
    // IP/UA so the owner can spot his own test hits.
    match /linkStats/{doc} {
      allow read: if isAdmin();
      allow write: if false;
      match /visits/{visit} { allow read: if isAdmin(); allow write: if false; }
    }

    // Bid board: tracked bid opportunities, admin only (writes: crud.ts).
    match /bids/{doc} { allow read: if isAdmin(); allow write: if false; }

    // Lead pipeline (CRM). Admins read it live in the browser; every write
    // goes through the server (lead card and Add lead server actions, the
    // voice assistant, Meta ads sheet sync, quote form, proposals), which
    // enforces the stage rules and appends history without losing entries.
    match /leads/{doc} { allow read: if isAdmin(); allow write: if false; }

    // Monthly marketing spend by lead source (dashboard cost per won job).
    // Doc id = YYYY-MM. Read and written through server actions; direct
    // admin reads allowed, no browser writes.
    match /marketingSpend/{month} { allow read: if isAdmin(); allow write: if false; }

    // Sent proposals (immutable snapshots, doc id = public token). Written only
    // by the server; customers read them through /proposal/<token>.
    match /proposals/{token} {
      allow read: if isAdmin();
      allow write: if false;
      // Add-only acceptance/decline evidence (what was shown, the consent
      // words, name, time, IP), written by the respond route with create().
      match /events/{id} { allow read: if isAdmin(); allow write: if false; }
    }

    // Delivery record for each office notice / customer copy
    // (src/services/notice-delivery.ts). Server only; failed ones show on
    // the dashboard through a server action.
    match /notices/{id} { allow read: if isAdmin(); allow write: if false; }

    // Bore-ON webhook delivery ids, one per delivery (create() makes a
    // repeat a no-op). Server only.
    match /boreOnDeliveries/{id} { allow read, write: if false; }

    // Integration credentials (Bore-ON API key, etc). NEVER world-readable —
    // that's why these are not in siteSettings. Not readable from any
    // browser either (admins included): Admin -> Settings gets set/last-4
    // status from the getIntegrationStatus server action and saves through
    // updateIntegrationSecret, both Admin SDK.
    match /integrationSecrets/{doc} { allow read, write: if false; }

    // Last sync result per integration (e.g. googleCalendar: lastOkAt,
    // lastError, lastErrorAt). Written by the server; Settings reads it
    // through the getIntegrationStatus server action.
    match /integrationStatus/{d} { allow read, write: if false; }

    // Change log: written only by the server (src/services/audit.ts), in the
    // same commit as the change it records. Owners may read it.
    match /auditLog/{id} { allow read: if isOwner(); allow write: if false; }

    // Soft-deleted documents (trash/{col}__{id}); restored or purged only
    // through the owner-only server actions in src/actions/trash.ts.
    match /trash/{id} { allow read, write: if false; }
    // Records of bulk runs (letter logging / imports, the repair tool): written
    // only by the server so they can be undone exactly. Admins may read them.
    match /importRuns/{id} { allow read: if isAdmin(); allow write: if false; }
    match /repairRuns/{id} { allow read: if isAdmin(); allow write: if false; }
  }
}
