rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Keep in sync with ADMIN_UIDS in src/lib/admin-allowlist.ts
    function isAdmin() {
      return request.auth != null && (
        request.auth.uid in [
          "9dFkbPZscRZXAiEkpEVlGNJ1gKm2",
          "GNYhCjyGudc2qnDoVzRnxCH4kuw2",
          "yDg9qK6577cKf3Ro3PvOQoUvDZh1",
          "2CIJrJ2DgxXIBULzPEb76mArbWX2"
        ]
        // Email fallback only for VERIFIED emails (see admin-allowlist.ts).
        || (request.auth.token.email_verified == true
            && request.auth.token.email in [
              "admin@fibernorth.com",
              "bill@fibernorth.com",
              "webadmin@fibernorth.com"
            ])
        || request.auth.token.admin == true
      );
    }
    // Browser uploads come only from the admin ImageUpload component, which
    // writes new timestamped paths. Allowed: JPEG/PNG/WEBP under 15MB.
    // SVG (can carry script) and everything else is refused, and an existing
    // object can never be overwritten (resource == null), so a stored file
    // — including quoteUploads/ — can't be swapped out from the browser.
    // Customer quote attachments (incl. PDF/HEIC) are written by the Admin
    // SDK in /api/quote, which bypasses these rules and sniffs the bytes.
    function isAdminImageUpload() {
      return isAdmin()
        && resource == null
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];
    }

    // Everything is private by default: admins can read/list, nobody else.
    // Site images are served through getDownloadURL() token links, which
    // work regardless of these rules, so nothing public depends on `list`.
    // quoteUploads/ (customer site plans/photos, written by the Admin SDK
    // in /api/quote) falls under this default and is admin-only.
    match /{allPaths=**} {
      allow read: if isAdmin();
      // create only: no update (overwrite) and no delete from the browser.
      allow create: if isAdminImageUpload();
    }

    // Public site image folders (admin ImageUpload `folder` props).
    // Single-object `get` only — no `list`, so the bucket can't be enumerated.
    match /{folder}/{allPaths=**} {
      allow get: if folder in ['blog', 'fleet', 'major-projects', 'projects', 'team'];
    }
  }
}
